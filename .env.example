# Base URL of the GT7 telemetry relay server.
# HTTP base URL — the app auto-derives the WebSocket URL by
# replacing http:// → ws:// (or https:// → wss://).
VITE_SERVER_URL=http://localhost:3000

# When VITE_SERVER_URL is unset: plain-HTTP pages connect to <host>:3000
# directly; HTTPS pages use the same-origin /relay path, which Vite proxies
# (HTTP + WebSocket) to RELAY_TARGET.
RELAY_TARGET=http://localhost:3000
